# ==============================================================================
# RAG_EVAL Workspace Environment Configuration Template
# ==============================================================================

# Database Connection (SQLite default for local work; PostgreSQL for production)
# In production, this connection uses the restricted 'rag_api' role.
DATABASE_URL=sqlite:///./rag_eval_hosted.db

# Worker Database Connection (PostgreSQL production queue worker)
# In production, this connection uses the restricted 'rag_worker' role.
# Defaults to DATABASE_URL if omitted.
# WORKER_DATABASE_URL=postgresql+psycopg://rag_worker:worker_password@localhost:5432/rag_eval

# Migration Database Connection (Required for running Alembic DDL migrations in production)
# Used ONLY out-of-band from the operator's machine. NEVER expose to the running application.
# MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:admin_password@localhost:5432/rag_eval

# Database Provisioning & Worker Controls (optional flags)
# SKIP_SCHEMA_INIT=false
# SKIP_RLS_SETUP=false
# DISABLE_IN_PROCESS_WORKER=false

# Credential Encryption Key (Fernet symmetric key for encrypting provider keys)
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key

# Service Owner Invitation Admin Token (used at /admin/invitations)
INVITATION_ADMIN_TOKEN=replace-with-a-random-admin-token

# Cookie Security (false for local HTTP development; true for HTTPS production)
COOKIE_SECURE=false

# Public Web Base URL
PUBLIC_BASE_URL=http://localhost:5173

# Authentication Development Mode (allows passwordless email sign-in via terminal log)
AUTH_DEV_MODE=true
RESEND_API_KEY=console
AUTH_EMAIL_FROM="RAG_EVAL <sign-in@localhost>"

# (Optional) Real Email Service via Resend (https://resend.com)
# RESEND_API_KEY=re_your_api_key_here
# AUTH_EMAIL_FROM="RAG_EVAL <sign-in@your-verified-domain.com>"

# (Optional) GitHub OAuth (https://github.com/settings/developers)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# (Optional) Google OAuth (https://console.cloud.google.com/apis/credentials)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ==============================================================================
# LLM Provider Configuration
# ==============================================================================
# Provider Selection: ollama (default), gemini, or groq
CHAT_PROVIDER=ollama
CHAT_MODEL=llama3.2:3b
CHAT_BASE_URL=http://localhost:11434
CHAT_API_KEY=

# Embedding Provider (currently only ollama supported)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434

# Ollama Local Service Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2:3b

# Gemini Provider (Google AI Studio - https://aistudio.google.com/app/apikey)
# Get API key from: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_CHAT_MODEL=gemini-3.8-flash

# Groq Provider (https://console.groq.com/keys)
# Get API key from: https://console.groq.com/keys
# GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com
GROQ_CHAT_MODEL=qwen/qwen3.8-27b

# ==============================================================================
# Provider Fallback Configuration
# ==============================================================================
# Enable automatic fallback to alternative providers on failure
# FALLBACK_ENABLED=true
# Comma-separated list of fallback providers in priority order (e.g., 'gemini,groq,ollama')
# FALLBACK_PROVIDERS=gemini,groq,ollama

# ==============================================================================
# Provider Retry Configuration
# ==============================================================================
# Enable retry for transient provider failures
RETRY_ENABLED=true
# Maximum generation attempts per provider (including initial attempt)
RETRY_MAX_ATTEMPTS=3
# Initial backoff delay in seconds
RETRY_BASE_DELAY_SECONDS=1.0
# Maximum backoff delay cap in seconds
RETRY_MAX_DELAY_SECONDS=10.0
# Exponential base for backoff calculation
RETRY_EXPONENTIAL_BASE=2.0
# Apply jitter to prevent synchronized retry storms
RETRY_JITTER_ENABLED=true
# Maximum total time budget for all retry attempts per provider (seconds)
RETRY_TIMEOUT_SECONDS=30.0

# ==============================================================================
# Provider Circuit Breaker Configuration
# ==============================================================================
# Enable circuit breaker for provider failure isolation
CIRCUIT_BREAKER_ENABLED=true
# Number of consecutive provider failures before opening circuit
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# Seconds to wait before attempting recovery (HALF_OPEN state)
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30.0
# Maximum probe calls allowed in HALF_OPEN state
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=1
# Rolling window in seconds for failure counting
CIRCUIT_BREAKER_WINDOW_SECONDS=60.0

# Workspace Storage
MAX_UPLOAD_BYTES=26214400
PRIVATE_DATA_DIR=./private_data
