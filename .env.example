# ==============================================================================
# RAG_EVAL Workspace Environment Configuration Template
# ==============================================================================

# Database Connection (SQLite default for local work; PostgreSQL for production)
DATABASE_URL=sqlite:///./rag_eval_hosted.db

# Credential Encryption Key (Fernet symmetric key for encrypting provider keys)
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key

# Service Owner Invitation Admin Token (used at /admin/invitations)
INVITATION_ADMIN_TOKEN=replace-with-a-random-admin-token

# Cookie Security (false for local HTTP development; true for HTTPS production)
COOKIE_SECURE=false

# Public Web Base URL
PUBLIC_BASE_URL=http://localhost:5173

# Authentication Development Mode (allows passwordless email sign-in via terminal log)
AUTH_DEV_MODE=true
RESEND_API_KEY=console
AUTH_EMAIL_FROM="RAG_EVAL <sign-in@localhost>"

# (Optional) Real Email Service via Resend (https://resend.com)
# RESEND_API_KEY=re_your_api_key_here
# AUTH_EMAIL_FROM="RAG_EVAL <sign-in@your-verified-domain.com>"

# (Optional) GitHub OAuth (https://github.com/settings/developers)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# (Optional) Google OAuth (https://console.cloud.google.com/apis/credentials)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Ollama Local Service Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2:3b

# Default Cloud Models
GEMINI_CHAT_MODEL=gemini-3.8-flash
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Workspace Storage
MAX_UPLOAD_BYTES=26214400
PRIVATE_DATA_DIR=./private_data
